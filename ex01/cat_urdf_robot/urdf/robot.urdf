<?xml version="1.0"?>
<robot name="myfirst">

    <material name="red">
        <color rgba="0.94 0.39 0.09 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.65 0 1"/>
    </material>


    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <origin rpy="0 1.57075 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.6" radius="0.2"/>
            </geometry>
            <origin rpy="0 1.57075 0"/>
        </collision>
    </link>


    <!-- Start legs -->
    <!-- Back right leg -->

    <link name="back_right_leg">
        <visual>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_to_back_right_leg" type="fixed">
        <parent link="base_link"/>
        <child link="back_right_leg"/>
        <origin xyz="-0.25 -0.15 -0.2"/>
    </joint>

    <link name="back_right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="back_right_leg_to_wheel" type="continuous">
        <parent link="back_right_leg"/>
        <child link="back_right_wheel"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 -0.2"/>
    </joint>

    <!-- Back left leg -->

    <link name="back_left_leg">
        <visual>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_to_back_left_leg" type="fixed">
        <parent link="base_link"/>
        <child link="back_left_leg"/>
        <origin xyz="-0.25 0.15 -0.2"/>
    </joint>

    <link name="back_left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="back_left_leg_to_wheel" type="continuous">
        <parent link="back_left_leg"/>
        <child link="back_left_wheel"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 -0.2"/>
    </joint>


    <!-- Front right leg -->

    <link name="front_right_leg">
        <visual>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_to_front_right_leg" type="fixed">
        <parent link="base_link"/>
        <child link="front_right_leg"/>
        <origin xyz="0.25 -0.15 -0.2"/>
    </joint>

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="front_right_leg_to_wheel" type="continuous">
        <parent link="front_right_leg"/>
        <child link="front_right_wheel"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 -0.2"/>
    </joint>


    <!-- Front left leg -->

    <link name="front_left_leg">
        <visual>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.4" radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_to_front_left_leg" type="fixed">
        <parent link="base_link"/>
        <child link="front_left_leg"/>
        <origin xyz="0.25 0.15 -0.2"/>
    </joint>

    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.05"/>
            </geometry>
            <origin rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="front_left_leg_to_wheel" type="continuous">
        <parent link="front_left_leg"/>
        <child link="front_left_wheel"/>
        <axis xyz="0 1 0"/>
        <origin xyz="0 0 -0.2"/>
    </joint>

    <!-- End legs -->

    <link name="tail">
        <visual>
            <geometry>
                <cylinder length="0.6" radius="0.07"/>
            </geometry>
            <origin xyz="0 0 0.3"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.6" radius="0.07"/>
            </geometry>
            <origin xyz="0 0 0.3"/>
        </collision>
    </link>
    <joint name="base_to_tail" type="fixed">
        <parent link="base_link"/>
        <child link="tail"/>
        <origin xyz="-0.25 0 0.05" rpy="0 -0.75 0"/>
    </joint>


    <link name="neck">
        <visual>
            <geometry>
                <cylinder length="0.15" radius="0.07"/>
            </geometry>
            <origin xyz="0 0 0.075"/>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.15" radius="0.07"/>
            </geometry>
            <origin xyz="0 0 0.075"/>
        </collision>
    </link>
    <joint name="base_to_neck" type="fixed">
        <parent link="base_link"/>
        <child link="neck"/>
        <origin xyz="0.25 0 0.1" rpy="0 1 0"/>
    </joint>


    <link name="head">
        <visual>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0.15"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0.15"/>
        </collision>
    </link>
    <joint name="neck_to_head" type="fixed">
        <parent link="neck"/>
        <child link="head"/>
        <origin xyz="-0.05 0 0.13" rpy="0 0.57 0"/>
    </joint>


    <link name="left_ear">
        <visual>
            <geometry>
                <box size="0.08 0.08 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0.25"/>
            <material name="orange"/>
        </visual>
    </link>
    <joint name="head_to_left_ear" type="fixed">
        <parent link="head"/>
        <child link="left_ear"/>
        <origin xyz="-0.10 0.08 0.15" rpy="0 0 0"/>
    </joint>


    <link name="right_ear">
        <visual>
            <geometry>
                <box size="0.08 0.08 0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 -0.25"/>
            <material name="orange"/>
        </visual>
    </link>
    <joint name="head_to_right_ear" type="fixed">
        <parent link="head"/>
        <child link="right_ear"/>
        <origin xyz="-0.10 -0.08 0.15" rpy="0 0 0"/>
    </joint>
</robot>
