<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <!--plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>true</static_publisher>
            <static_update_frequency>1</static_update_frequency>
        </plugin-->

        <!--plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>robot/odom</odom_frame>
            <robot_base_frame>robot/base_link</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin-->

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>back_left_leg_to_wheel</joint_name>
            <joint_name>front_left_leg_to_wheel</joint_name>

            <joint_name>back_right_leg_to_wheel</joint_name>
            <joint_name>front_right_leg_to_wheel</joint_name>
        </plugin>

        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            
            <left_joint>back_left_leg_to_wheel</left_joint>
            <!-- <left_joint>front_left_leg_to_wheel</left_joint> -->

            <right_joint>back_right_leg_to_wheel</right_joint>
            <!-- <right_joint>front_right_leg_to_wheel</right_joint> -->

            <child_frame_id>catbot/base_link</child_frame_id>
            <wheel_separation>0.3</wheel_separation>
            <wheel_radius>0.05</wheel_radius>

            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <robot_base_frame>base_link</robot_base_frame>
            <publish_odom_tf>true</publish_odom_tf>
            <odom_publish_frequency>10</odom_publish_frequency>
        </plugin>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="back_left_wheel">
        <material>Gazebo/Red</material>
    </gazebo>
    <gazebo reference="front_left_wheel">
        <material>Gazebo/Red</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>
    <gazebo reference="back_right_wheel">
        <material>Gazebo/Red</material>
    </gazebo>    
    <gazebo reference="front_right_wheel">
        <material>Gazebo/Red</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

    <gazebo reference="left_eye">
        <material>Gazebo/Black</material>
        <sensor name="lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <gz_frame_id>lidar_link</gz_frame_id>
            <visualize>false</visualize>
            <ray>
                <scan>
                <horizontal>
                    <samples>180</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
                </scan>
                <range>
                <min>0.15</min>
                <max>10.0</max>
                </range>
            </ray>
            <always_on>1</always_on>
        </sensor>
    </gazebo>

    <gazebo reference="right_eye">
      <material>Gazebo/Black</material>
      <sensor name="depth_camera" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>6</update_rate>
        <topic>depth_camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.51843645</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>421.61578369140625</fx>
              <fy>421.61578369140625</fy>
              <cx>422.2854309082031</cx>
              <cy>236.57237243652344</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </gazebo>

    <plugin name="CameraInfoPlugin" filename="libgz-sim-camera-info-system.so">
      <topic>depth_camera/camera_info</topic>
    </plugin>

    <gazebo reference="tail">
      <material>Gazebo/Orange</material>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        
        <imu>
          <noise>
            <type>gaussian</type>
            <!-- Rate noise -->
            <rate>
              <mean>0.0</mean>
              <stddev>0.00017</stddev>  <!-- ±1°/s -->
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </rate>
            <!-- Acceleration noise -->
            <accel>
              <mean>0.0</mean>
              <stddev>0.017</stddev>  <!-- ±0.1 m/s² -->
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </accel>
          </noise>
        </imu>
      </sensor>
    </gazebo>
    
</robot>
