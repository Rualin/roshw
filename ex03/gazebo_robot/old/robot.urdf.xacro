<?xml version="1.0"?>

<robot name="visual_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:include filename="$(find gazebo_robot)/robot.gazebo.xacro" />

  <!-- Константы -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  
  <!-- Размеры -->
  <xacro:property name="base_radius" value="0.6" />
  <xacro:property name="base_length" value="0.2" />
  
  <xacro:property name="leg_length" value="0.6" />
  <xacro:property name="leg_width" value="0.3" />
  <xacro:property name="leg_thickness" value="0.1" />
  
  <xacro:property name="base_width" value="0.4" />
  <xacro:property name="base_height" value="0.1" />
  
  <xacro:property name="wheel_radius" value="0.035" />
  <xacro:property name="wheel_length" value="0.1" />
  
  <xacro:property name="head_radius" value="0.2" />
  <xacro:property name="box_size" value="0.08" />
  
  <!-- Позиции -->
  <xacro:property name="leg_offset" value="0.65" />
  <xacro:property name="wheel_offset" value="0.133333333333" />

  <!-- Materials для RViz -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="white">
    <color rgba="0.95 0.95 0.95 1"/>
  </material>
  <material name="gray">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <!-- Основная база -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="${base_length}" radius="${base_radius}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${base_length}" radius="${base_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Макрос для создания ноги -->
  <xacro:macro name="create_leg" params="side">
    <link name="${side}_leg">
      <visual>
        <geometry>
          <box size="${leg_thickness} ${leg_thickness} ${leg_width}"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry>
          <box size="${leg_thickness} ${leg_thickness} ${leg_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="base_to_${side}_leg" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_leg"/>
      <!-- Ноги крепятся к боковой поверхности базы -->
      <origin xyz="0 ${(1 if side == 'left' else -1) * (base_radius + leg_thickness/2)} ${-leg_width/2}" rpy="0 0 0"/>
    </joint>

    <link name="${side}_base">
      <visual>
        <geometry>
          <box size="${base_width} ${base_height} ${base_height}"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry>
          <box size="${base_width} ${base_height} ${base_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${side}_base_joint" type="fixed">
      <parent link="${side}_leg"/>
      <child link="${side}_base"/>
      <!-- Основание крепится в конце ноги -->
      <origin xyz="0 0 ${-leg_width/2}" rpy="0 0 0"/>
    </joint>

    <!-- Макрос для создания колеса -->
    <xacro:macro name="create_wheel" params="position">
      <link name="${side}_${position}_wheel">
        <visual>
          <origin rpy="${M_PI/2} 0 0" xyz="0 0 0"/>
          <geometry>
            <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
          </geometry>
          <material name="black"/>
        </visual>
        <collision>
          <origin rpy="${M_PI/2} 0 0" xyz="0 0 0"/>
          <geometry>
            <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.1"/>
          <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
      </link>

      <joint name="${side}_${position}_wheel_joint" type="continuous">
        <parent link="${side}_base"/>
        <child link="${side}_${position}_wheel"/>
        <!-- Колеса крепятся снизу основания -->
        <origin xyz="${(1 if position == 'front' else -1) * wheel_offset} 0 ${-base_height/2}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:macro>

    <!-- Создание переднего и заднего колеса -->
    <xacro:create_wheel position="front"/>
    <xacro:create_wheel position="back"/>
  </xacro:macro>

  <!-- Создание ног -->
  <xacro:create_leg side="right"/>
  <xacro:create_leg side="left"/>

  <!-- Голова -->
  <link name="head">
    <visual>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="head_swivel" type="fixed">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 ${base_length/2 + head_radius}"/>
  </joint>

  <!-- Коробка на голове -->
  <link name="box">
    <visual>
      <geometry>
        <box size="${box_size} ${box_size} ${box_size}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${box_size} ${box_size} ${box_size}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tobox" type="fixed">
    <parent link="head"/>
    <child link="box"/>
    <origin xyz="0.1814 0 0.1414"/>
  </joint>

  <!-- Камера -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.3 0 0.22" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.2 0 0.22" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Gazebo plugins
  <gazebo>
    <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_back_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_back_wheel_joint</right_joint>
      
      <wheel_separation>1.3</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/model/robot/cmd_vel</topic>
    </plugin>
  </gazebo> -->

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic> 
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
        </range>
      </ray>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>6</update_rate>
      <topic>depth_camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.51843645</horizontal_fov>
        <image>
          <width>848</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
        <lens>
          <intrinsics>
            <fx>421.61578369140625</fx>
            <fy>421.61578369140625</fy>
            <cx>422.2854309082031</cx>
            <cy>236.57237243652344</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>

  <plugin name="CameraInfoPlugin" filename="libgz-sim-camera-info-system.so">
    <topic>depth_camera/camera_info</topic>
  </plugin>

  <!-- IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Gazebo IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      
      <imu>
        <noise>
          <type>gaussian</type>
          <!-- Rate noise -->
          <rate>
            <mean>0.0</mean>
            <stddev>0.00017</stddev>  <!-- ±1°/s -->
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </rate>
          <!-- Acceleration noise -->
          <accel>
            <mean>0.0</mean>
            <stddev>0.017</stddev>  <!-- ±0.1 m/s² -->
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
    </sensor>
  </gazebo>

  <material name="green">
    <color rgba="0 0.8 0 1"/>
  </material>

  <!-- Gazebo materials (для симуляции) -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  
  <gazebo reference="head">
    <material>Gazebo/White</material>
  </gazebo>
  
  <gazebo reference="box">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_leg">
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="right_leg">
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="left_base">
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="right_base">
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_back_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_front_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_back_wheel">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="imu_link">
    <material>Gazebo/Green</material>
  </gazebo>
</robot>